{
  "manifest_version": 3,
  "name": "Accessible Reels — ponte local",
  "version": "1.3.1",
  "description": "Permite que o Accessible Reels controle TikTok e Instagram nas sessões do navegador.",
  "permissions": ["tabs", "debugger", "storage"],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "http://127.0.0.1:43119/*",
    "http://127.0.0.1:43120/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["audio_guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["audio_guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["instagram.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Accessible Reels"
  }
}
